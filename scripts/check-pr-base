#!/usr/bin/env bash
# Check the live production base from the checkout being verified.
set -euo pipefail
if (($# != 0)); then
  echo "usage: scripts/check-pr-base" >&2
  exit 2
fi

head=$(git rev-parse --verify HEAD)
base=$(git ls-remote --exit-code --refs origin refs/heads/main |
  awk '$2 == "refs/heads/main" { print $1 }')
if [[ -z $base ]]; then
  echo "check-pr-base: origin has no refs/heads/main" >&2
  exit 2
fi
if ! git cat-file -e "$base^{commit}" 2>/dev/null; then
  git fetch --quiet --no-tags --no-write-fetch-head origin "$base"
fi

if git merge-base --is-ancestor "$base" "$head"; then
  printf 'check-pr-base: %s contains origin/main %s\n' "$head" "$base"
else
  status=$?
  if ((status == 1)); then
    printf 'check-pr-base: %s is missing origin/main %s\n' "$head" "$base" >&2
  fi
  exit "$status"
fi
