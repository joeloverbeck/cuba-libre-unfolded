#!/usr/bin/env bash
# The repository's checks; CI runs this same entry point. It stops at the first
# failure. The ignored native tests need private cards and a GPU, so they stay
# manual (README, "Checks and development seat"; docs/agents/seat.md).
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
# Name what was checked, so a saved log identifies its source.
echo "revision: $(git rev-parse HEAD)"
changes=$(git status --porcelain --untracked-files=normal)
if [[ -z $changes ]]; then
  echo "working tree: clean"
else
  echo "working tree: $(wc -l <<<"$changes") changed path(s) differ from the revision; this log checks uncommitted source"
fi
# A merge's conflict markers left in any tracked text file (#71 committed some in
# README) fail before anything is built. `git grep` exits 0 on a match, 1 on none,
# and above 1 on an error, which must not pass as "none".
rc=0
git grep -I -n -E '^(<<<<<<< |>>>>>>> )' || rc=$?
if ((rc == 0)); then
  echo "conflict markers found in tracked files" >&2
  exit 1
elif ((rc > 1)); then
  echo "conflict-marker search failed: git grep exited $rc" >&2
  exit 1
fi
echo "conflict markers: none"
# docs/agents/seat.md catalogues every native regression, one bullet per test (#91). A
# `fn native_*` is a native regression by name; rename a helper rather than list it.
# grep exits 1 on no match, which pipefail would turn into a silent failure here; an
# empty side fails below with its own message instead.
documented=$({ grep -oE '^- `native_[a-z0-9_]+`' docs/agents/seat.md || [[ $? == 1 ]]; } | sed 's/^- `//; s/`$//' | sort)
defined=$({ grep -rhoE 'fn native_[a-z0-9_]+' src tests || [[ $? == 1 ]]; } | sed 's/^fn //' | sort -u)
if [[ -z $documented || -z $defined ]]; then
  echo "native catalogue: found no native tests in docs/agents/seat.md or in src/ and tests/" >&2
  exit 1
fi
if [[ $documented != "$defined" ]]; then
  echo "native catalogue: docs/agents/seat.md differs from the native tests (< documented, > defined):" >&2
  diff <(echo "$documented") <(echo "$defined") >&2 || true
  exit 1
fi
echo "native catalogue: $(wc -l <<<"$defined") tests, all listed once"
# Interface sizes follow the window, never the desktop's scale factor (ADR 0002, #50). A
# type size or length written as a bare number is fixed in logical pixels; write it in
# reference pixels and multiply it by the layout scale. Zero and scaled expressions pass.
# The check catches a size written as one bare number in `font_size: ….into()` or
# `font_size = ….into()`, `from_font_size(…)`, `with_font_size(…)`, `px(…)` and the
# `Px(…)` variants (Val, FontSize, LineHeight, LetterSpacing). Review judges other forms,
# such as UiRect::px(…) with several numbers or FontSize::from(…).
literal='-?[0-9._]*[1-9][0-9._]*(f32)?'
rc=0
git grep -n -E "font_size *[:=] *$literal\.into\(\)|(from|with)_font_size\($literal\)|\b(px|Px)\($literal\)" -- src || rc=$?
if ((rc == 0)); then
  echo "fixed sizes: the lines above set a size in logical pixels; scale it with the window (ADR 0002)" >&2
  exit 1
elif ((rc > 1)); then
  echo "fixed-size search failed: git grep exited $rc" >&2
  exit 1
fi
echo "fixed sizes: none of the checked bare-number forms in src/"
# Interface colours come from `src/tabletop/palette.rs`, whose tests check each one against
# the FigCraft `Atlas` variables (#53). #46 copied a near-miss ink from older code, which
# matches no variable, so only keeping literals out of other files catches it. A colour
# that is not an Atlas variable stays where it is used, with `// own colour: <reason>` on
# the literal's line (foundation 4 keeps the older VectorCraft components' colours). The
# check catches bevy_color's RGB constructors: `Color::srgb`, `srgba`, `srgb_u8`,
# `srgba_u8`, `srgb_u32`, `srgba_u32`, `srgb_from_array`, `linear_rgb` and `linear_rgba`;
# `Srgba::new`, `rgb`, `rgb_u8`, `rgba_u8` and `hex`; `LinearRgba::new` and `rgb`. Review
# judges other forms, such as hsl/oklch constructors, struct literals and named constants.
colour='\b(Color::(srgba?(_u8|_u32|_from_array)?|linear_rgba?)|Srgba::(new|rgb|rgb_u8|rgba_u8|hex)|LinearRgba::(new|rgb))\('
rc=0
git grep -n -E -e "$colour" --and --not -e '// own colour: ' -- src ':(exclude)src/tabletop/palette.rs' || rc=$?
if ((rc == 0)); then
  echo "colour literals: declare the lines above in palette.rs, or mark each // own colour: <reason>" >&2
  exit 1
elif ((rc > 1)); then
  echo "colour-literal search failed: git grep exited $rc" >&2
  exit 1
fi
echo "colour literals: none outside palette.rs without a reason"
# Agents read Markdown by section, and the Read tool truncates a line past 2,000
# characters (#91, #95, #97). Prose lines stay at or under 1,000 characters. Fenced
# code and table rows are skipped; docs/principles/ is the adopted constitution,
# kept verbatim. Untracked files are included so a new document is checked before
# it is committed. C.UTF-8 makes ${#line} count characters, not bytes.
long_lines() {
  local LC_ALL=C.UTF-8 file line number fenced found=0 files
  # A failed listing must not pass as "no files": wait reports the
  # process substitution's status.
  mapfile -d '' -t files < <(git ls-files -z --cached --others --exclude-standard -- \
    README.md 'docs/*.md' 'art/*.md' ':(exclude)docs/principles/')
  wait "$!" || { echo "Markdown line length: git ls-files failed" >&2; return 1; }
  if ((${#files[@]} == 0)); then
    echo "Markdown line length: found no Markdown files to check" >&2
    return 1
  fi
  for file in "${files[@]}"; do
    [[ -f $file ]] || continue
    number=0
    fenced=0
    while IFS= read -r line || [[ -n $line ]]; do
      number=$((number + 1))
      if [[ $line =~ ^[[:space:]]*(\`\`\`|~~~) ]]; then
        fenced=$((1 - fenced))
      elif ((!fenced)) && ! [[ $line =~ ^[[:space:]]*\| ]] && ((${#line} > 1000)); then
        echo "$file:$number: ${#line} characters" >&2
        found=1
      fi
    done <"$file"
  done
  return "$found"
}
if ! long_lines; then
  echo "Markdown line length: split each line above into shorter paragraphs or a list" >&2
  exit 1
fi
echo "Markdown line length: no prose line over 1,000 characters in README, docs/ or art/"
# Builds are bounded by `.cargo/config.toml`, which every Cargo command here reads.
cargo fmt --all --check
cargo clippy --locked --all-targets -- -D warnings
cargo test --locked
cargo clippy --locked --all-targets --features tabletop -- -D warnings
cargo test --locked --features tabletop
# Exercise focused native discovery in CI with the real libtest binaries.
# Listing needs neither the private card faces nor a renderer.
native_case=rally::native_free_rally_can_choose_zero_in_a_qualifying_base_space
library_case=tabletop::seat::tests::native_seat_skips_the_die_by_enter_space_or_a_click_on_the_tray
scripts/native --list --exact "$native_case" "$library_case" >/dev/null
missing=retro_missing_native_test
if output=$(scripts/native --list "$native_case" "$missing" 2>&1); then
  echo "native filter check: an unmatched name passed beside a valid name" >&2
  exit 1
fi
if [[ $output != *"No ignored native test matches filter '$missing'"* ]]; then
  echo "$output" >&2
  exit 1
fi
echo "native filters: both binaries discovered, missing name refused"
