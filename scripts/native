#!/usr/bin/env bash
# Run ignored regressions from both test binaries: those that launch the app, four at
# once (`--test-threads=1` to 4 chooses), and the in-process ones serially.
set -euo pipefail
# Bash reads a script as it runs. The braces make it read all of this one first, so an edit to
# this script during a run cannot change the run.
{
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
read -r started _ < /proc/uptime

revision=$(git rev-parse HEAD)
echo "revision: $revision"
changes=$(git status --porcelain --untracked-files=normal)
if [[ -z $changes ]]; then
  echo "working tree: clean"
else
  echo "working tree: $(wc -l <<<"$changes") changed path(s) differ from the revision"
fi
# A hash of every tracked file this suite could build or read: all but documents, agent
# settings and CI, so a file added later counts. Commits with the same hash run the same
# suite, as far as this repository decides it: the private cards, the renderer and the
# environment are not in it. Prints nothing while any of those files differs from HEAD.
suite_inputs() {
  local among=(. ':(exclude)*.md' ':(exclude)docs' ':(exclude)LICENSE' ':(exclude).agents'
    ':(exclude).claude' ':(exclude).codex' ':(exclude).github' ':(exclude).githooks'
    ':(exclude).mcp.json')
  local dirty
  dirty=$(git status --porcelain --untracked-files=normal -- "${among[@]}")
  if [[ -z $dirty ]]; then git ls-files -s -- "${among[@]}" | git hash-object --stdin; fi
}
before=$(suite_inputs)
# `--inputs` prints this checkout's hash alone, to compare with an earlier run's.
if [[ ${1:-} == --inputs ]]; then
  echo "suite inputs: ${before:-not named, files the suite reads differ from the revision}"
  exit
fi

# From a worktree, evidence goes to the main checkout: `git worktree remove` deletes the
# worktree's own ignored files. A set CUBA_NATIVE_EVIDENCE wins.
common=$(dirname -- "$(git rev-parse --path-format=absolute --git-common-dir)")
if [[ -z ${CUBA_NATIVE_EVIDENCE:-} && $common != "$(git rev-parse --show-toplevel)" ]]; then
  branch=$(git branch --show-current)
  branch=${branch:-detached}
  run=$(git rev-parse --short HEAD)-$(date +%Y%m%d-%H%M%S)
  # A dirty tree's evidence does not go under the clean revision's name.
  if [[ -n $changes ]]; then run=${run/-/-dirty-}; fi
  export CUBA_NATIVE_EVIDENCE="$common/local/verification/native/${branch//\//-}/$run"
fi

# Four apps fit `scripts/heavy`'s memory scope (docs/agents/parallel-work.md, "Native
# memory"). The option is taken out of the arguments, because libtest refuses it twice.
apps=4
args=()
while (($#)); do
  case $1 in
    --) args+=("$@"); break ;;
    --test-threads)
      if (($# < 2)); then echo "--test-threads needs a number" >&2; exit 2; fi
      apps=$2
      shift ;;
    --test-threads=*) apps=${1#*=} ;;
    *) args+=("$1") ;;
  esac
  shift
done
if [[ ! $apps =~ ^[1-4]$ ]]; then
  echo "Native regressions run 1 to 4 apps at once, not '$apps'." >&2
  exit 2
fi
set -- "${args[@]}"

# `--shard K/N` runs the Kth of N parts, so each fits a foreground command; the library
# regressions run with the first.
shard=
if [[ ${1:-} == --shard ]]; then
  shard=${2:-}
  if [[ ! $shard =~ ^([1-9][0-9]?)/([1-9][0-9]?)$ ]] || ((BASH_REMATCH[1] > BASH_REMATCH[2])); then
    echo "--shard needs K/N, such as 1/3" >&2
    exit 2
  fi
  part=${BASH_REMATCH[1]} parts=${BASH_REMATCH[2]}
  shift 2
  if (($#)); then echo "--shard takes no other argument" >&2; exit 2; fi
fi

# Keep the original libtest arguments for discovery and execution. Extract just
# the positive name filters so one valid filter cannot mask a misspelled one.
args=("$@")
given=$#
filters=()
list=false
selection=()
exact=false
bench=false
run_tests=false
user_log=
report_time=(--report-time)
while (($#)); do
  case $1 in
    -h|--help) exec cargo test --locked --features tabletop --test native -- --help ;;
    --list) list=true ;;
    --exact) exact=true; selection+=("$1") ;;
    --) shift; filters+=("$@"); break ;;
    --skip)
      if (($# < 2)); then echo "--skip needs a filter" >&2; exit 2; fi
      selection+=("$1" "$2")
      shift ;;
    --bench) bench=true ;;
    --test) run_tests=true ;;
    -Z)
      if (($# < 2)); then echo "-Z needs an option" >&2; exit 2; fi
      selection+=("$1" "$2")
      shift ;;
    -Z*|--skip=*|--exclude-should-panic|--include-ignored|--ignored)
      selection+=("$1") ;;
    --report-time) report_time=() ;;
    --logfile=*) user_log=${1#*=} ;;
    --logfile)
      if (($# < 2)); then echo "--logfile needs a path" >&2; exit 2; fi
      user_log=$2; shift ;;
    --format|--color|--shuffle-seed)
      # Space-separated option values aren't test names.
      if (($# > 1)); then shift; fi ;;
    -*) ;;
    *) filters+=("$1") ;;
  esac
  shift
done

# In benchmark-only mode libtest lists ordinary tests but ignores them on execution.
if "$bench" && ! "$run_tests" && ! "$list"; then
  echo "Benchmark-only mode skips native regressions. Use --test to execute them." >&2
  exit 2
fi
cargo_test=(cargo test --locked --features tabletop)
# The library's regressions share one renderer in one process, so they stay serial.
harness=(--ignored --test-threads=1)
app_harness=(--ignored "--test-threads=$apps")
if ((${#filters[@]} + ${#selection[@]})); then
  # Let libtest apply the selection; keep output formatting and logging options
  # for the caller's actual run so discovery always reads a plain catalogue.
  listing=$("${cargo_test[@]}" --test native --lib -- "${harness[@]}" --list "${selection[@]}" -- "${filters[@]}")
  # The stable libtest catalogue prints one fully qualified "name: test" per line.
  mapfile -t names < <(sed -n 's/: test$//p' <<<"$listing")
  for filter in "${filters[@]}"; do
    found=false
    for name in "${names[@]}"; do
      if [[ $name == "$filter" ]] || { ! "$exact" && [[ $name == *"$filter"* ]]; }; then
        found=true
        break
      fi
    done
    if ! "$found"; then
      echo "No ignored native test matches filter '$filter' in either test binary." >&2
      exit 1
    fi
  done
  if ((${#names[@]} == 0)); then
    echo "No ignored native tests selected in either test binary." >&2
    exit 1
  fi
fi
if "$list"; then
  exec "${cargo_test[@]}" --test native --lib -- "${harness[@]}" "${args[@]}"
fi

if [[ -n $shard ]]; then
  listing=$("${cargo_test[@]}" --test native -- "${harness[@]}" --list)
  mapfile -t names < <(sed -n 's/: test$//p' <<<"$listing" | awk -v k="$part" -v n="$parts" 'NR % n == k % n')
  if ((${#names[@]} == 0)); then echo "shard $shard holds no test" >&2; exit 2; fi
  args=(--exact "${names[@]}")
  echo "shard $shard: ${#names[@]} tests"
fi

: "${CUBA_TEST_CARDS:?set CUBA_TEST_CARDS to the selected card directory (README, Where files live)}"
if [[ -n ${CUBA_NATIVE_EVIDENCE:-} ]]; then echo "evidence: $CUBA_NATIVE_EVIDENCE"; fi
whole=false
if [[ -n $shard ]] || ((given == 0)); then whole=true; fi
timing_root=${CUBA_NATIVE_EVIDENCE:-local/verification/native}
mkdir -p -- "$timing_root"
timing=$(mktemp -d -- "$timing_root/timing-XXXXXX")
echo "timings: $timing"
# Runtime logs copied during this invocation identify the adapter Bevy actually used.
touch "$timing/started"
# Cargo sets the test environment and resolves the executable. Enable unstable
# libtest timing only on the executable; setting bootstrap on Cargo rebuilds Bevy.
timed_cargo=("${cargo_test[@]}" --config "target.'cfg(target_os = \"linux\")'.runner=['env','RUSTC_BOOTSTRAP=1']")
failed=()
run_timed() {
  local label=$1 log
  shift
  local logfile=()
  local previous_log=
  if [[ -n $user_log && -f $user_log ]]; then previous_log=$(stat -c %y -- "$user_log"); fi
  log="$timing/$label.log"
  if [[ -z $user_log ]]; then logfile=(--logfile "$log"); fi
  # Keep the caller's arguments after the timing options, including a literal --.
  local target=(--lib)
  if [[ $label == app ]]; then target=(--test native); fi
  "${timed_cargo[@]}" "${target[@]}" -- -Z unstable-options "${report_time[@]}" \
    "${logfile[@]}" "$@" || failed+=("$label")
  if [[ -n $user_log && -f $user_log && $(stat -c %y -- "$user_log") != "$previous_log" ]]; then
    cp -- "$user_log" "$log"
  fi
}

echo "== tests/native.rs, $apps at once"
run_timed app "${app_harness[@]}" "${args[@]}"
if [[ -z $shard ]]; then
  echo "== library (in-process)"
  run_timed library "${harness[@]}" "${args[@]}"
elif ((part == 1)); then
  echo "== library (in-process)"
  run_timed library "${harness[@]}"
fi

read -r ended _ < /proc/uptime
{
  echo "revision: $revision${changes:+ (working tree modified)}; shard: ${shard:-unsharded}; app threads: $apps; library threads: 1"
  echo "renderer settings: WGPU_BACKEND=${WGPU_BACKEND:-default} VK_DRIVER_FILES=${VK_DRIVER_FILES:-default} CUBA_NATIVE_SOFTWARE_VULKAN=${CUBA_NATIVE_SOFTWARE_VULKAN:-0}"
  if [[ -n ${CUBA_NATIVE_EVIDENCE:-} ]]; then
    roots=("$CUBA_NATIVE_EVIDENCE")
  else
    shopt -s nullglob
    roots=(local/verification/issue-*)
  fi
  adapters=
  if ((${#roots[@]})); then
    adapters=$(find "${roots[@]}" -maxdepth 2 -type f -name '*-runtime.log' -newer "$timing/started" \
      -exec sed -nE 's/.*AdapterInfo \{ name: "([^"]+)".*backend: ([^, }]+).*/\1 (\2)/p' {} + | sort -u)
  fi
  echo "observed adapter: ${adapters:-unreported}"
  LC_ALL=C awk -v start="$started" -v end="$ended" 'BEGIN { printf "runner wall time: %.2fs\n", end-start }'
  if ((${#failed[@]})); then echo "failed in: ${failed[*]}"; else echo "result: passed"; fi
  echo "seconds  result  test (slowest first)"
  for log in "$timing"/{app,library}.log; do
    [[ -f $log ]] || continue
    awk '$NF ~ /^<[0-9.]+s>$/ {print substr($NF, 2, length($NF)-3), $1, $(NF-1)}' "$log"
  done | LC_ALL=C sort -nr
} | tee "$timing/summary.txt"

if ((${#failed[@]})); then
  echo "native regressions failed in: ${failed[*]}" >&2
  exit 1
fi
if [[ -n $shard ]]; then
  echo "native regressions: shard $shard passed; the suite needs all $parts"
else
  echo "native regressions: all passed"
fi
# Only a passed shard or a passed unfiltered run names its inputs, so a filtered or
# failed one cannot be taken for the suite.
if "$whole"; then
  if [[ -n $before && $(suite_inputs) == "$before" ]]; then
    echo "suite inputs: $before"
  else
    echo "suite inputs not named: files the suite reads differ from the revision or changed during the run"
  fi
fi
exit
}
