#!/usr/bin/env bash
# Run ignored regressions from both test binaries, serially.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

echo "revision: $(git rev-parse HEAD)"
changes=$(git status --porcelain --untracked-files=normal)
if [[ -z $changes ]]; then
  echo "working tree: clean"
else
  echo "working tree: $(wc -l <<<"$changes") changed path(s) differ from the revision"
fi
# A hash of every tracked file this suite could build or read: all but documents, agent
# settings and CI, so a file added later counts. Commits with the same hash run the same
# suite, as far as this repository decides it: the private cards, the renderer and the
# environment are not in it. Prints nothing while any of those files differs from HEAD.
suite_inputs() {
  local among=(. ':(exclude)*.md' ':(exclude)docs' ':(exclude)LICENSE' ':(exclude).agents'
    ':(exclude).claude' ':(exclude).codex' ':(exclude).github' ':(exclude).githooks'
    ':(exclude).mcp.json')
  local dirty
  dirty=$(git status --porcelain --untracked-files=normal -- "${among[@]}")
  if [[ -z $dirty ]]; then git ls-files -s -- "${among[@]}" | git hash-object --stdin; fi
}
before=$(suite_inputs)

# From a worktree, evidence goes to the main checkout: `git worktree remove` deletes the
# worktree's own ignored files. A set CUBA_NATIVE_EVIDENCE wins.
common=$(dirname -- "$(git rev-parse --path-format=absolute --git-common-dir)")
if [[ -z ${CUBA_NATIVE_EVIDENCE:-} && $common != "$(git rev-parse --show-toplevel)" ]]; then
  branch=$(git branch --show-current)
  branch=${branch:-detached}
  run=$(git rev-parse --short HEAD)-$(date +%Y%m%d-%H%M%S)
  # A dirty tree's evidence does not go under the clean revision's name.
  if [[ -n $changes ]]; then run=${run/-/-dirty-}; fi
  export CUBA_NATIVE_EVIDENCE="$common/local/verification/native/${branch//\//-}/$run"
fi

# `--shard K/N` runs the Kth of N parts, so each fits a foreground command; the library
# regressions run with the first.
shard=
if [[ ${1:-} == --shard ]]; then
  shard=${2:-}
  if [[ ! $shard =~ ^([1-9][0-9]?)/([1-9][0-9]?)$ ]] || ((BASH_REMATCH[1] > BASH_REMATCH[2])); then
    echo "--shard needs K/N, such as 1/3" >&2
    exit 2
  fi
  part=${BASH_REMATCH[1]} parts=${BASH_REMATCH[2]}
  shift 2
  if (($#)); then echo "--shard takes no other argument" >&2; exit 2; fi
fi

# Keep the original libtest arguments for discovery and execution. Extract just
# the positive name filters so one valid filter cannot mask a misspelled one.
args=("$@")
given=$#
filters=()
list=false
selection=()
exact=false
bench=false
run_tests=false
while (($#)); do
  case $1 in
    -h|--help) exec cargo test --locked --features tabletop --test native -- --help ;;
    --list) list=true ;;
    --exact) exact=true; selection+=("$1") ;;
    --) shift; filters+=("$@"); break ;;
    --skip)
      if (($# < 2)); then echo "--skip needs a filter" >&2; exit 2; fi
      selection+=("$1" "$2")
      shift ;;
    --bench) bench=true ;;
    --test) run_tests=true ;;
    -Z)
      if (($# < 2)); then echo "-Z needs an option" >&2; exit 2; fi
      selection+=("$1" "$2")
      shift ;;
    -Z*|--skip=*|--exclude-should-panic|--include-ignored|--ignored)
      selection+=("$1") ;;
    --test-threads|--test-threads=*)
      threads=${1#--test-threads=}
      if [[ $1 == --test-threads ]]; then shift; threads=${1:-}; fi
      if [[ $threads != 1 ]]; then
        echo "Native regressions share a renderer. Use --test-threads=1." >&2
        exit 2
      fi ;;
    --format|--color|--shuffle-seed|--logfile)
      # Space-separated option values aren't test names.
      if (($# > 1)); then shift; fi ;;
    -*) ;;
    *) filters+=("$1") ;;
  esac
  shift
done

# In benchmark-only mode libtest lists ordinary tests but ignores them on execution.
if "$bench" && ! "$run_tests" && ! "$list"; then
  echo "Benchmark-only mode skips native regressions. Use --test to execute them." >&2
  exit 2
fi
cargo_test=(cargo test --locked --features tabletop)
harness=(--ignored --test-threads=1)
if ((${#filters[@]} + ${#selection[@]})); then
  # Let libtest apply the selection; keep output formatting and logging options
  # for the caller's actual run so discovery always reads a plain catalogue.
  listing=$("${cargo_test[@]}" --test native --lib -- "${harness[@]}" --list "${selection[@]}" -- "${filters[@]}")
  # The stable libtest catalogue prints one fully qualified "name: test" per line.
  mapfile -t names < <(sed -n 's/: test$//p' <<<"$listing")
  for filter in "${filters[@]}"; do
    found=false
    for name in "${names[@]}"; do
      if [[ $name == "$filter" ]] || { ! "$exact" && [[ $name == *"$filter"* ]]; }; then
        found=true
        break
      fi
    done
    if ! "$found"; then
      echo "No ignored native test matches filter '$filter' in either test binary." >&2
      exit 1
    fi
  done
  if ((${#names[@]} == 0)); then
    echo "No ignored native tests selected in either test binary." >&2
    exit 1
  fi
fi
if "$list"; then
  exec "${cargo_test[@]}" --test native --lib -- "${harness[@]}" "${args[@]}"
fi

if [[ -n $shard ]]; then
  listing=$("${cargo_test[@]}" --test native -- "${harness[@]}" --list)
  mapfile -t names < <(sed -n 's/: test$//p' <<<"$listing" | awk -v k="$part" -v n="$parts" 'NR % n == k % n')
  if ((${#names[@]} == 0)); then echo "shard $shard holds no test" >&2; exit 2; fi
  args=(--exact "${names[@]}")
  echo "shard $shard: ${#names[@]} tests"
fi

: "${CUBA_TEST_CARDS:?set CUBA_TEST_CARDS to the selected card directory (README, Where files live)}"
if [[ -n ${CUBA_NATIVE_EVIDENCE:-} ]]; then echo "evidence: $CUBA_NATIVE_EVIDENCE"; fi
whole=false
if [[ -n $shard ]] || ((given == 0)); then whole=true; fi
failed=()
echo "== tests/native.rs"
"${cargo_test[@]}" --test native -- "${harness[@]}" "${args[@]}" || failed+=("tests/native.rs")
if [[ -z $shard ]]; then
  echo "== library (in-process)"
  "${cargo_test[@]}" --lib -- "${harness[@]}" "${args[@]}" || failed+=("library")
elif ((part == 1)); then
  echo "== library (in-process)"
  "${cargo_test[@]}" --lib -- "${harness[@]}" || failed+=("library")
fi
if ((${#failed[@]})); then
  echo "native regressions failed in: ${failed[*]}" >&2
  exit 1
fi
if [[ -n $shard ]]; then
  echo "native regressions: shard $shard passed; the suite needs all $parts"
else
  echo "native regressions: all passed"
fi
# Only a passed shard or a passed unfiltered run names its inputs, so a filtered or
# failed one cannot be taken for the suite.
if "$whole"; then
  if [[ -n $before && $(suite_inputs) == "$before" ]]; then
    echo "suite inputs: $before"
  else
    echo "suite inputs not named: files the suite reads differ from the revision or changed during the run"
  fi
fi
