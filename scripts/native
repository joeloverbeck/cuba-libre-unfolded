#!/usr/bin/env bash
# Run ignored regressions from both test binaries: those that launch the app, four at
# once (`--test-threads=1` to 4 chooses), and the in-process ones serially.
set -euo pipefail
# Bash reads a script as it runs. The braces make it read all of this one first, so an edit to
# this script during a run cannot change commands in that invocation.
{
if [[ ${1:-} == --timed-harness ]]; then
  # Cargo invokes this after it resolves the executable. Leave the caller's log
  # alone if Cargo never dispatches a test harness.
  shift
  export RUSTC_BOOTSTRAP=1
  position=$CUBA_NATIVE_LOG_POSITION
  width=$CUBA_NATIVE_LOG_WIDTH
  before_log=("${@:2:position-1}")
  after_log=("${@:position+width+1}")
  # The harness parses its options before opening the logfile. Validate them
  # without running tests. Help can succeed without opening the logfile.
  preflight="$CUBA_NATIVE_HARNESS_LOG.preflight"
  opens_logfile=false
  if "$1" --list "${before_log[@]}" "--logfile=$preflight" "${after_log[@]}" >/dev/null 2>&1 \
    && [[ -f $preflight ]]; then
    opens_logfile=true
  fi
  rm -f -- "$preflight"
  if ! "$opens_logfile"; then exec "$@"; fi
  if ! exec {caller_fd}>"$CUBA_NATIVE_CALLER_LOG"; then
    # Keep libtest's diagnosis of an unusable logfile path.
    exec "$@"
  fi
  # Duplicate libtest's one logfile as it writes. Close our descriptors in
  # the harness so a detached app cannot keep the mirror open on interruption.
  exec {log_fd}> >(trap '' INT TERM; tee --output-error=warn -- "$CUBA_NATIVE_HARNESS_LOG" >&"$caller_fd")
  log_pid=$!
  status=0
  "$1" "${before_log[@]}" "--logfile=/proc/$BASHPID/fd/$log_fd" "${after_log[@]}" \
    {log_fd}>&- {caller_fd}>&- || status=$?
  exec {log_fd}>&- {caller_fd}>&-
  if ! wait "$log_pid" && ((status == 0)); then status=1; fi
  exit "$status"
fi

read -r started _ < /proc/uptime
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
revision=$(git rev-parse --verify HEAD)

# A hash of every tracked file this suite could build or read: all but documents, agent
# settings and CI, so a file added later counts. Commits with the same hash run the same
# suite, as far as this repository decides it: the private cards, the renderer and the
# environment are not in it. Prints nothing while any of those files differs from HEAD.
suite_inputs() {
  local among=(. ':(exclude)*.md' ':(exclude)docs' ':(exclude)LICENSE' ':(exclude).agents'
    ':(exclude).claude' ':(exclude).codex' ':(exclude).github' ':(exclude).githooks'
    ':(exclude).mcp.json')
  local dirty
  dirty=$(git status --porcelain --untracked-files=normal -- "${among[@]}") || return
  if [[ -z $dirty ]]; then git ls-files -s -- "${among[@]}" | git hash-object --stdin; fi
}
before=$(suite_inputs)
# `--inputs` prints the same fingerprint record as a passing run's summary.
if [[ ${1:-} == --inputs ]]; then
  if [[ -z $before ]]; then
    echo 'native: suite inputs unavailable because files the suite reads differ from the revision' >&2
    exit 1
  fi
  printf 'suite inputs: %s\n' "$before"
  exit
fi

echo "revision: $revision"
changes=$(git status --porcelain --untracked-files=normal)
if [[ -z $changes ]]; then
  echo "working tree: clean"
else
  echo "working tree: $(wc -l <<<"$changes") changed path(s) differ from the revision"
fi

# Four apps fit `scripts/heavy`'s memory scope (docs/agents/parallel-work.md, "Native
# memory"). The option is taken out of the arguments, because libtest refuses it twice.
apps=4
args=()
while (($#)); do
  case $1 in
    --) args+=("$@"); break ;;
    --test-threads)
      if (($# < 2)); then echo "--test-threads needs a number" >&2; exit 2; fi
      apps=$2
      shift ;;
    --test-threads=*) apps=${1#*=} ;;
    *) args+=("$1") ;;
  esac
  shift
done
if [[ ! $apps =~ ^[1-4]$ ]]; then
  echo "Native regressions run 1 to 4 apps at once, not '$apps'." >&2
  exit 2
fi
set -- "${args[@]}"

# `--shard K/N` runs the Kth of N parts, so each fits a foreground command; the library
# regressions run with the first.
shard=
if [[ ${1:-} == --shard ]]; then
  shard=${2:-}
  if [[ ! $shard =~ ^([1-9][0-9]?)/([1-9][0-9]?)$ ]] || ((BASH_REMATCH[1] > BASH_REMATCH[2])); then
    echo "--shard needs K/N, such as 1/3" >&2
    exit 2
  fi
  part=${BASH_REMATCH[1]} parts=${BASH_REMATCH[2]}
  shift 2
  if (($#)); then echo "--shard takes no other argument" >&2; exit 2; fi
fi

# Keep the original libtest arguments for discovery and execution. Extract just
# the positive name filters so one valid filter cannot mask a misspelled one.
args=("$@")
given=$#
filters=()
list=false
selection=()
exact=false
bench=false
run_tests=false
user_log=
caller_log_count=0
unstable=(-Z unstable-options)
report_time=(--report-time)
while (($#)); do
  case $1 in
    -h|--help) exec cargo test --locked --features tabletop --test native -- --help ;;
    --list) list=true ;;
    --exact) exact=true; selection+=("$1") ;;
    --) shift; filters+=("$@"); break ;;
    --skip)
      if (($# < 2)); then echo "--skip needs a filter" >&2; exit 2; fi
      selection+=("$1" "$2")
      shift ;;
    --bench) bench=true ;;
    --test) run_tests=true ;;
    -Z|-qZ)
      if (($# < 2)); then echo "-Z needs an option" >&2; exit 2; fi
      selection+=("$1" "$2")
      unstable=()
      shift ;;
    -Z*|-qZ*) selection+=("$1"); unstable=() ;;
    --skip=*|--exclude-should-panic|--include-ignored|--ignored)
      selection+=("$1") ;;
    --report-time) report_time=() ;;
    --logfile=*)
      user_log=${1#*=}
      log_position=$((given-$#))
      log_width=1
      ((caller_log_count+=1))
      ;;
    --logfile)
      if (($# < 2)); then echo "--logfile needs a path" >&2; exit 2; fi
      user_log=$2
      log_position=$((given-$#))
      log_width=2
      ((caller_log_count+=1))
      shift ;;
    --format|--color|--shuffle-seed)
      # Space-separated option values aren't test names.
      if (($# > 1)); then shift; fi ;;
    -*) ;;
    *) filters+=("$1") ;;
  esac
  shift
done

# In benchmark-only mode libtest lists ordinary tests but ignores them on execution.
if "$bench" && ! "$run_tests" && ! "$list"; then
  echo "Benchmark-only mode skips native regressions. Use --test to execute them." >&2
  exit 2
fi
cargo_test=(cargo test --locked --features tabletop)
# Cargo sets the test environment and resolves the executable. Enable unstable
# libtest options only on the executable; setting bootstrap on Cargo rebuilds Bevy.
runner_key="target.'cfg(target_os = \"linux\")'.runner"
timed_cargo=("${cargo_test[@]}" --config "$runner_key=['env','RUSTC_BOOTSTRAP=1']")
listing_cargo=("${cargo_test[@]}")
if ((${#unstable[@]} == 0)); then listing_cargo=("${timed_cargo[@]}"); fi
# The library's regressions share one renderer in one process, so they stay serial.
harness=(--ignored --test-threads=1)
app_harness=(--ignored "--test-threads=$apps")
if ((${#filters[@]} + ${#selection[@]})); then
  # Let libtest apply the selection; keep output formatting and logging options
  # for the caller's actual run so discovery always reads a plain catalogue.
  listing=$("${listing_cargo[@]}" --test native --lib -- "${harness[@]}" --list "${selection[@]}" -- "${filters[@]}")
  # The stable libtest catalogue prints one fully qualified "name: test" per line.
  mapfile -t names < <(sed -n 's/: test$//p' <<<"$listing")
  for filter in "${filters[@]}"; do
    found=false
    for name in "${names[@]}"; do
      if [[ $name == "$filter" ]] || { ! "$exact" && [[ $name == *"$filter"* ]]; }; then
        found=true
        break
      fi
    done
    if ! "$found"; then
      echo "No ignored native test matches filter '$filter' in either test binary." >&2
      exit 1
    fi
  done
  if ((${#names[@]} == 0)); then
    echo "No ignored native tests selected in either test binary." >&2
    exit 1
  fi
fi
if "$list"; then
  exec "${listing_cargo[@]}" --test native --lib -- "${harness[@]}" "${args[@]}"
fi

if [[ -n $shard ]]; then
  listing=$("${cargo_test[@]}" --test native -- "${harness[@]}" --list)
  mapfile -t names < <(sed -n 's/: test$//p' <<<"$listing" | awk -v k="$part" -v n="$parts" 'NR % n == k % n')
  if ((${#names[@]} == 0)); then echo "shard $shard holds no test" >&2; exit 2; fi
  args=(--exact "${names[@]}")
  echo "shard $shard: ${#names[@]} tests"
fi

: "${CUBA_TEST_CARDS:?set CUBA_TEST_CARDS to the selected card directory (README, Where files live)}"
# A worktree's default evidence lives in a fresh directory in the main checkout.
common=$(dirname -- "$(git rev-parse --path-format=absolute --git-common-dir)")
if [[ -z ${CUBA_NATIVE_EVIDENCE:-} && $common != "$(git rev-parse --show-toplevel)" ]]; then
  branch=$(git branch --show-current)
  branch=${branch:-detached}
  run=$(git rev-parse --short HEAD)-$(date +%Y%m%d-%H%M%S)
  if [[ -n $changes ]]; then run=${run/-/-dirty-}; fi
  evidence_root="$common/local/verification/native/${branch//\//-}"
  mkdir -p -- "$evidence_root"
  app_evidence=$(mktemp -d -- "$evidence_root/$run-XXXXXX")
  export CUBA_NATIVE_EVIDENCE="$app_evidence"
fi
if [[ -n ${CUBA_NATIVE_EVIDENCE:-} ]]; then echo "evidence: $CUBA_NATIVE_EVIDENCE"; fi
whole=false
if [[ -n $shard ]] || ((given == 0)); then whole=true; fi
timing_root=${CUBA_NATIVE_EVIDENCE:-local/verification/native}
mkdir -p -- "$timing_root"
timing=$(mktemp -d -- "$timing_root/timing-XXXXXX")
echo "timings: $timing"
failed=()
statuses=()
run_timed() {
  local label=$1 failure_label=$1
  shift
  local log="$timing/$label.log"
  local target=(--lib)
  local options=("${harness[@]}")
  local runner=("${timed_cargo[@]}")
  local stderr_fd stderr_pid status=0 stderr_status=0
  if [[ $label == app ]]; then
    target=(--test native)
    options=("${app_harness[@]}")
    failure_label=tests/native.rs
    local -x CUBA_NATIVE_APP_ADAPTER_LOG="$timing/app-adapters.log"
    exec {stderr_fd}>&2
  else
    # The library's Bevy renderer logs directly to stderr.
    exec {stderr_fd}> >(tee -- "$timing/library.stderr" >&2)
    stderr_pid=$!
  fi
  if ((caller_log_count == 0)); then
    options+=(--logfile "$log")
  elif ((caller_log_count == 1)); then
    runner=("${cargo_test[@]}" --config "$runner_key=['bash','scripts/native','--timed-harness']")
    local -x CUBA_NATIVE_HARNESS_LOG="$log" CUBA_NATIVE_CALLER_LOG="$user_log"
    # Count arguments before the caller's logfile, including the executable.
    local -x CUBA_NATIVE_LOG_POSITION=$((1 + ${#unstable[@]} + ${#report_time[@]} + ${#options[@]} + log_position))
    local -x CUBA_NATIVE_LOG_WIDTH=$log_width
  fi
  # Duplicate logfile options are left for libtest to diagnose.
  "${runner[@]}" "${target[@]}" -- "${unstable[@]}" "${report_time[@]}" \
    "${options[@]}" "$@" 2>&"$stderr_fd" || status=$?
  exec {stderr_fd}>&-
  if [[ -v stderr_pid ]]; then wait "$stderr_pid" || stderr_status=$?; fi
  if ((status || stderr_status)); then
    failed+=("$failure_label")
    statuses+=("$failure_label: Cargo=$status, stderr=$stderr_status")
  fi
}

echo "== tests/native.rs, $apps at once"
run_timed app "${args[@]}"
library_threads=skipped
if [[ -z $shard ]]; then
  library_threads=1
  echo "== library (in-process)"
  run_timed library "${args[@]}"
elif ((part == 1)); then
  library_threads=1
  echo "== library (in-process)"
  run_timed library
fi

read -r ended _ < /proc/uptime
{
  echo "revision: $revision${changes:+ (working tree modified)}; shard: ${shard:-unsharded}; app threads: $apps; library threads: $library_threads"
  echo "observed suite inputs at start: ${before:-unavailable (working tree differs from the revision)}"
  echo "renderer settings: WGPU_BACKEND=${WGPU_BACKEND:-default} VK_DRIVER_FILES=${VK_DRIVER_FILES:-default} CUBA_NATIVE_SOFTWARE_VULKAN=${CUBA_NATIVE_SOFTWARE_VULKAN:-0}"
  adapter_line='s/.*AdapterInfo \{ name: "([^"]+)".*backend: ([^, }]+).*/\1 (\2)/p'
  app_adapters=
  if [[ -f $timing/app-adapters.log ]]; then
    app_adapters=$(sed -nE "$adapter_line" "$timing/app-adapters.log" | sort -u)
  fi
  library_adapters=
  if [[ -f $timing/library.stderr ]]; then
    library_adapters=$(sed -nE "$adapter_line" "$timing/library.stderr" | sort -u)
  fi
  echo "observed app adapter: ${app_adapters:-unreported}"
  echo "observed library adapter: ${library_adapters:-unreported}"
  LC_ALL=C awk -v start="$started" -v end="$ended" 'BEGIN { printf "runner wall time: %.2fs\n", end-start }'
  if ((${#failed[@]})); then
    printf 'failed in: %s\n' "${failed[*]}"
    printf 'exit statuses (%s)\n' "${statuses[@]}"
  else
    echo "result: passed"
  fi
  echo "seconds  result  test (slowest first)"
  for log in "$timing"/{app,library}.log; do
    [[ -f $log ]] || continue
    awk '$NF ~ /^<[0-9.]+s>$/ && $1 ~ /^(ok|failed:?)$/ {
      sub(/:$/, "", $1)
      print substr($NF, 2, length($NF)-3), $1, $(NF-1)
    }' "$log"
  done | LC_ALL=C sort -nr
} | tee "$timing/summary.txt"

if ((${#failed[@]})); then
  echo "native regressions failed in: ${failed[*]}" >&2
  exit 1
fi
# Only a passed shard or a passed unfiltered run names its inputs, so a filtered or
# failed one cannot be taken for the suite.
if "$whole"; then
  if [[ -n $before && $(suite_inputs) == "$before" ]]; then
    verdict="suite inputs: $before"
  else
    verdict="suite inputs not named: files the suite reads differ from the revision or changed during the run"
  fi
  printf '%s\n' "$verdict" | tee -a "$timing/summary.txt"
fi
logs=("$timing/app.log")
if [[ $library_threads != skipped ]]; then logs+=("$timing/library.log"); fi
passed=$(awk '$1 == "ok" {n++} END {print n+0}' "${logs[@]}")
if [[ -n $shard ]]; then
  coverage="shard $shard"
elif "$whole"; then
  coverage="full suite"
else
  coverage="selected run"
fi
printf 'native regressions: %s passed (%s tests)\n' "$coverage" "$passed" | tee -a "$timing/summary.txt"
exit
}
