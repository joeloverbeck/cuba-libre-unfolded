#!/usr/bin/env bash
# Runs one heavy command (a cargo build or test, scripts/check, scripts/native) alone:
# under the shared heavy lock, in a fresh memory scope, and with a worktree's private
# Cargo target (docs/agents/parallel-work.md). Run it from the checkout the command is
# for: `scripts/heavy cargo test --locked --test integration seat_brief::`.
# `scripts/heavy --stop` ends this checkout's commands, running or waiting for the lock,
# and any app they left.
set -euo pipefail

if (($# == 0)); then
  echo "usage: scripts/heavy COMMAND [ARG ...] | scripts/heavy --stop" >&2
  exit 2
fi
checkout=$(git rev-parse --show-toplevel)
main=$(dirname -- "$(git rev-parse --path-format=absolute --git-common-dir)")
# One scope name per checkout, so --stop reaches only this checkout's commands. Sibling
# repositories' guards find heavy scopes by systemd's own `run-` prefix.
unit=run-cuba-heavy-$(sha256sum <<<"$checkout" | cut -c1-12)

if [[ $1 == --stop ]]; then
  listing=$(systemctl --user list-units --type=scope --plain --no-legend "$unit-*")
  mapfile -t units < <(awk 'NF { print $1 }' <<<"$listing")
  if ((${#units[@]} == 0)); then
    echo "scripts/heavy: nothing is running or waiting for $checkout"
    exit 0
  fi
  systemctl --user stop "${units[@]}"
  echo "scripts/heavy: stopped ${units[*]}"
  exit 0
fi

# The scope opens before the wait, so it also holds a command that waits for the lock.
if [[ $1 != --in-scope ]]; then
  exec systemd-run --user --scope --collect -q --unit="$unit-$$" \
    -p MemoryHigh=6G -p MemoryMax=7G -p MemorySwapMax=1G -- \
    "$(realpath -- "${BASH_SOURCE[0]}")" --in-scope "$@"
fi
shift

# The main checkout keeps Cargo's default target. A worktree builds into
# local/target-<branch>, with a branch's slashes as dashes; a set CARGO_TARGET_DIR wins.
if [[ $checkout != "$main" && -z ${CARGO_TARGET_DIR:-} ]]; then
  branch=$(git branch --show-current)
  if [[ -z $branch ]]; then
    echo "scripts/heavy: a detached worktree has no branch to name its target; set CARGO_TARGET_DIR" >&2
    exit 2
  fi
  export CARGO_TARGET_DIR="$main/local/target-${branch//\//-}"
fi
mkdir -p -- "$main/local"
cd -- "$checkout"
# The command and an app it starts inherit the lock.
exec 9>"$main/local/heavy.lock"
flock 9

# Cargo trusts file times, so a target moved or copied from another checkout can serve
# that checkout's binaries as fresh. A target last used from another checkout, or never
# stamped, loses this crate's build.
target=${CARGO_TARGET_DIR:-$checkout/target}
stamp=$target/.heavy-checkout
if [[ -d $target ]] && [[ ! -f $stamp || $(<"$stamp") != "$checkout" ]]; then
  echo "scripts/heavy: $target is not stamped for this checkout; discarding this crate's build" >&2
  cargo clean --quiet --locked -p cuba-libre-unfolded
fi
if [[ ! -d $target ]]; then
  mkdir -p -- "$target"
  # Cargo writes this only into a directory it creates.
  echo "Signature: 8a477f597d28d172789f06886806bc55" > "$target/CACHEDIR.TAG"
fi
printf '%s\n' "$checkout" > "$stamp"

# A native run takes the larger memory scope, with four apps, when the owner's ruling of
# 2026-11-18 allows it: no cargo or rustc runs anywhere on the machine, and at least 16 GB
# are available. Otherwise it keeps this scope and `scripts/native` runs three (#187).
if [[ ${1##*/} == native ]]; then
  available=$(awk '/^MemAvailable:/ { print int($2 / 1048576) }' /proc/meminfo)
  scope=$(awk -F: '$1 == 0 { sub(/.*\//, "", $3); print $3 }' /proc/self/cgroup)
  # pgrep exits 1 on no match; any other failure cannot pass as "none running".
  rc=0
  pgrep -x 'cargo|rustc' >/dev/null || rc=$?
  if ((rc != 1)); then
    kept="another build may be running"
  elif ((available < 16)); then
    kept="only $available GB are available"
  elif ! systemctl --user set-property --runtime "$scope" MemoryHigh=10G MemoryMax=12G; then
    kept="its limits could not be raised"
  else
    kept=
    export CUBA_NATIVE_APPS=4
  fi
  if [[ -n $kept ]]; then
    echo "scripts/heavy: native run keeps the 6 GB scope: $kept" >&2
  else
    echo "scripts/heavy: native run takes the 10 GB scope, with four apps" >&2
  fi
fi
exec "$@"
