#!/usr/bin/env bash
# Refuses a commit whose Rust source is not formatted, the first thing scripts/check
# and CI would refuse. Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd -- "$(git rev-parse --show-toplevel)"
if ! cargo fmt --all --check >/dev/null 2>&1; then
  echo "pre-commit: Rust source is not formatted; run 'cargo fmt --all' and commit again" >&2
  exit 1
fi
